# ─────────────────────────────────────────────────────────────────────────────
# Trek Calling Agent — configuration
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Service ──────────────────────────────────────────────────────────────────
PORT=8090
LOG_LEVEL=INFO
# Comma-separated companyCodes the agent is allowed to answer for. Empty = all.
ENABLED_COMPANY_CODES=

# ── WhatsApp / Meta ──────────────────────────────────────────────────────────
# Used by Pipecat's WhatsAppClient to accept/terminate calls on Meta's Cloud API.
# These are the SAME credentials the Node backend stores per company in
# IntegrationConfig. For a single-tenant pilot, set them here directly.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=

# ── Sarvam (ASR + TTS) ───────────────────────────────────────────────────────
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
# "codemix" is the mode that survives Hinglish sentence-internal switching.
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_VOICE=anushka
SARVAM_TTS_LANGUAGE=hi-IN

# ── LLM (Gemini Flash — same provider the WhatsApp bot already meters) ────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── TrekOps grounding ────────────────────────────────────────────────────────
# Control-plane Mongo URI (the one the Node backend uses as MONGO_URI).
# The agent reads Company + IntegrationConfig from the control-plane DB and
# departures/treks from the per-company DB named in Company.dbName.
MONGO_URI=
MONGO_CONTROL_DB=admin

# Node API base URL — all WRITES go through here so business logic stays in one
# place (lead creation, WhatsApp handoff).
TREKOPS_API_URL=http://127.0.0.1:8080
# Must match JWT_SECRET in the Node backend — the agent mints its own short-lived
# service token rather than holding a 7-day user token.
JWT_SECRET=
# Mongo ObjectId of the bot user the service token impersonates (for audit trails).
SERVICE_USER_ID=000000000000000000000000

# ── Shared secret for the Node → agent call forward ──────────────────────────
AGENT_FORWARD_SECRET=

# ── Behaviour ────────────────────────────────────────────────────────────────
# Seconds to wait for a human agent to pick up before the AI answers.
# 0 = AI answers immediately (after-hours mode).
HUMAN_GRACE_SECONDS=12
MAX_CALL_SECONDS=420
